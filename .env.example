# Google Drive OAuth Client ID (used for Phase 6 Blob fallback when VITE_DRIVE_STREAMING=false)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Phase 7 Media Proxy URL (Google Drive HTTP Range streaming service)
VITE_MEDIA_PROXY_URL=http://localhost:3000

# Feature Flag: Enable Phase 7 Drive HTTP Range streaming (default: false for safe fallback)
VITE_DRIVE_STREAMING=false
