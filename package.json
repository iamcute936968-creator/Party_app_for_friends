{
  "name": "party.json",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only database,auth --project demo-watch-party --config firebase.emulators.json \"node --test --test-force-exit tests/rules/database.test.mjs\"",
    "test:rtc": "firebase emulators:exec --only database,auth --project demo-watch-party --config firebase.emulators.json \"node node_modules/@playwright/test/cli.js test --config=playwright.rtc.config.js\""
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "lucide-react": "^0.547.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase": "12.18.0",
    "globals": "^16.4.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^3.4.18",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "postcss-selector-parser": "6.1.5"
  }
}
